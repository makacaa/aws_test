# OpenTofu / Terraform working files (.terraform.lock.hcl IS committed)
.terraform/
terraform.tfstate
terraform.tfstate.backup
terraform.tfstate.d/

# tfstate is NOT committed: it lives in the persistent state bucket
# (localemu-tf-state : state/aws_test.tfstate), pulled/pushed by the Action

# python
__pycache__/
*.pyc

# secrets: never commit credentials of any kind
secrets.env
*.env
!secrets.example.env
credentials*
*.pem
*.key
id_rsa*
*.log

# emulator artifacts
emu-export/
*.json.tmp
